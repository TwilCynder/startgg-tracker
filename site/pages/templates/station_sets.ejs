<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" href="/assets/icon/startggtracker256.png">
        <link rel="stylesheet" href="/styles/main.css">
        <link rel="stylesheet" href="/styles/sets-display.css">
        <link rel="stylesheet" href="/styles/set-tracking-pages.css">
        <link rel="stylesheet" href="/styles/station_sets.css">
        <link rel="stylesheet" href="/styles/loading.css">
        <link rel="stylesheet" href="/styles/switchElement.css">
        <link rel="stylesheet" href="/styles/login.css">
    </head>
    <body>
        <%- include("./fragments/login-overlay.html") %>
        <div class = "header">
            <a class = "logo" href="/index.html"><img class = "logo" src="/assets/icon/startggtracker256.png"></a>
            <div class = "sggt-container"><a class="sggt" href = "/index.html">SggT</a> <div class = "pub">by TwilCynder</div> </div>
            <div class = "event-input-container">
                Event : 
                <input class = "input event-input" type="text">
                <div class ="button">GO</div>
                <div class = "switch-container">
                    <div class = "switch-button"><div class = "switch-button-circle"></div></div>
                    <div class = "switch-texts">
                        <div class = "switch-text-top">Stations</div>
                        <div class = "switch-text-bot">Streams</div>
                    </div>
                </div>
            </div>
        </div>
        <div class = "content-container">
            <%- include("./fragments/loading-error.html") %>
            <div class ="loading-display-container loading">
                <div class="loader"></div>
                <div class = "loading-progress-line">Loading matches <span id="loading-progress">...</span></div>
                <div class="loading-text">
                    This should take a few seconds
                </div>
            </div>
            <div class = "content stations-content"></div>
        </div>
        <script src = "/scripts/station_sets.js" type="module"></script>
    </body>
</html>